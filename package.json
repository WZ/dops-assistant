{
  "name": "dops-assistant",
  "version": "0.4.0.1",
  "description": "Agentic infrastructure monitoring assistant — Grafana MCP + CLI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:web",
    "start": "node dist/server/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:rca-eval": "tsx src/eval/rca-eval.ts --min-score 20",
    "test:discover-eval": "tsx src/eval/discover-eval.ts --input src/eval/fixtures/discover-k8s-fixture.yaml --min-score 75 --require-per-service",
    "cli": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_NO_WARNINGS=1 tsx src/cli/index.tsx",
    "cli:investigate": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_NO_WARNINGS=1 tsx src/cli/index.tsx investigate",
    "cli:chat": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_NO_WARNINGS=1 tsx src/cli/index.tsx chat",
    "cli:mcp-check": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_NO_WARNINGS=1 tsx src/cli/index.tsx mcp-check",
    "cli:discover": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_NO_WARNINGS=1 tsx src/cli/index.tsx discover",
    "cli:e2e": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_NO_WARNINGS=1 tsx src/cli/index.tsx e2e",
    "discover": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_NO_WARNINGS=1 tsx src/cli/index.tsx discover",
    "investigate": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx dev/run-investigation.ts",
    "dev:web": "concurrently \"NODE_TLS_REJECT_UNAUTHORIZED=0 tsx watch src/server/index.ts\" \"vite --config vite.config.ts\"",
    "build:web": "vite build --config vite.config.ts",
    "web": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_NO_WARNINGS=1 tsx src/server/index.ts",
    "seed:demo": "DATA_DIR=data-demo DB_PATH=data-demo/dops.sqlite tsx scripts/seed-demo.ts",
    "demo": "DEMO_MODE=true CONFIG_PATH=demo/config.yaml DATA_DIR=data-demo DB_PATH=data-demo/dops.sqlite npm run web",
    "export-static": "tsx scripts/export-static.ts",
    "build:demo-static": "rm -rf dist/web && VITE_DEMO_STATIC=true npm run build:web && npm run seed:demo && npm run export-static"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@inkjs/ui": "^2.0.0",
    "@mastra/core": "^1.13.2",
    "@mastra/libsql": "^1.7.0",
    "@mastra/mcp": "^1.2.1",
    "@mastra/memory": "^1.8.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xyflow/react": "^12.10.1",
    "ai": "^6.0.116",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "croner": "^10.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "ink": "^6.8.0",
    "lucide-react": "^0.577.0",
    "mastra": "^1.3.12",
    "nodemailer": "^8.0.5",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.7.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "undici": "^7.25.0",
    "ws": "^8.19.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
