{
  "name": "dops-assistant",
  "version": "0.1.0",
  "description": "Agentic infrastructure monitoring assistant — Grafana MCP + CLI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "cli": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_NO_WARNINGS=1 tsx src/cli.tsx",
    "discover": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_NO_WARNINGS=1 tsx src/discover.tsx",
    "investigate": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx dev/run-investigation.ts",
    "dev:web": "concurrently \"NODE_TLS_REJECT_UNAUTHORIZED=0 tsx watch src/server/index.ts\" \"vite --config vite.config.ts\"",
    "build:web": "vite build --config vite.config.ts",
    "web": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_NO_WARNINGS=1 tsx src/server/index.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@inkjs/ui": "^2.0.0",
    "@mastra/core": "^1.13.2",
    "@mastra/libsql": "^1.7.0",
    "@mastra/mcp": "^1.2.1",
    "@mastra/memory": "^1.8.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xyflow/react": "^12.10.1",
    "ai": "^6.0.116",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "ink": "^6.8.0",
    "lucide-react": "^0.577.0",
    "mastra": "^1.3.12",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.7.2",
    "tailwind-merge": "^3.5.0",
    "ulid": "^3.0.2",
    "ws": "^8.19.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
