# Dockerfile.demo — read-only public demo variant.
#
# Differences from the main Dockerfile:
#   - Keeps tsx + the seed script in the final image so the entrypoint can
#     seed the database before the server starts.
#   - Sets DEMO_MODE=true and DATA_DIR=/data by default.
#   - Entrypoint runs `seed-demo` once per container start, writing a fresh
#     SQLite DB and services.yaml/providers.yaml to the ephemeral volume.
#
# No OPENAI_API_KEY is needed — demo mode short-circuits every LLM call.

# ---- Build stage: TypeScript + Vite frontend (matches main Dockerfile) ----
FROM node:22-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ARG NPM_STRICT_SSL=true

COPY package*.json ./
RUN npm config set strict-ssl ${NPM_STRICT_SSL} && \
    NODE_TLS_REJECT_UNAUTHORIZED=$([ "$NPM_STRICT_SSL" = "true" ] && echo 1 || echo 0) npm ci

COPY tsconfig.json vite.config.ts ./
COPY src/ ./src/
RUN npm run build

RUN find dist -type f \( -name '*.d.ts' -o -name '*.d.ts.map' -o -name '*.js.map' \) -delete

# DO NOT prune dev deps — the demo image needs tsx at runtime to execute
# the seed script against the compiled server's db module.

# ---- Production stage ----
FROM node:22-slim
WORKDIR /app

ENV NODE_ENV=production
ENV DEMO_MODE=true
ENV DATA_DIR=/data
ENV DB_PATH=/data/dops.sqlite
ENV CONFIG_PATH=/app/demo/config.yaml
ENV PORT=3000

COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src ./src
COPY scripts/ ./scripts/
COPY demo/ ./demo/

RUN mkdir -p /data

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))" || exit 1

# Entrypoint: seed the DB on every container start (idempotent — the seed
# script wipes and recreates), then start the compiled server. Using tsx
# directly avoids a separate compile step for the seed script.
CMD ["sh", "-c", "npx tsx scripts/seed-demo.ts && node dist/server/index.js"]
