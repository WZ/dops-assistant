llm:
  model: gpt-4
  apiKey: "${OPENAI_API_KEY}"
  # baseURL: "https://your-compatible-endpoint/v1"  # Optional: override for gpt-oss-120b etc.

  # Optional: retry policy for transient LLM-call failures (network errors,
  # HTTP 408/409/429/5xx flagged retryable by the provider). Tool errors are
  # NOT retried — only the LLM API itself. Tool-using agent paths (anomaly,
  # evidence, planning, synthesis) only retry when the investigation forces
  # readOnlyTools (e.g. webhook-triggered runs). Manual investigations that
  # allow write tools effectively get maxAttempts=1 to avoid replaying tool
  # calls. See docs/runbook.md for the full picture.
  # retry:
  #   maxAttempts: 8         # 1..15, default 8
  #   initialDelayMs: 2000   # first backoff, default 2s
  #   maxDelayMs: 60000      # cap on exponential growth, default 60s
  #   jitterPercent: 0.3     # 0..2, fraction of base delay added as jitter

# Optional bearer token required for mutating (non-GET) API requests.
# apiKey: "${DOPS_API_KEY}"

providers:
  - name: grafana
    roles: [metrics, logs, dashboards]
    mcpServer:
      transport: http
      url: ${GRAFANA_MCP_URL}
      # enabledTools:
      #   - query_prometheus
      #   - list_prometheus_metric_metadata
      #   - query_loki_logs
      #   - list_loki_label_names
      #   - list_loki_label_values
      #   - list_datasources
      #   - search_dashboards
      #   - get_dashboard_by_uid
      #   - get_dashboard_panel_queries
      #   - get_panel_image
      #   - list_alert_rules
      #   - get_alert_rule_by_uid

  # Kubernetes MCP — direct K8s API access for pod events, deployments, HPA
  # - name: kubernetes
  #   roles: [infrastructure]
  #   mcpServer:
  #     transport: http
  #     url: ${K8S_MCP_URL}

  # GitLab MCP — recent deployments, merge requests, pipeline status
  # - name: gitlab
  #   roles: [changes]
  #   mcpServer:
  #     transport: http
  #     url: ${GITLAB_MCP_URL}

  # Coroot MCP — live service topology for dependency graphs and request rates
  # - name: coroot
  #   roles: [dependencies]
  #   mcpServer:
  #     transport: http
  #     url: ${COROOT_MCP_URL}

services:
  # Services are loaded from services.yaml (generated by `npm run discover`).
  # You can also add static overrides here — they take precedence over discovered ones.
  - name: payments-api
    metrics:
      - query: 'rate(http_requests_total{service="payments"}[5m])'
        description: "Request rate"
      - query: 'histogram_quantile(0.99, rate(http_duration_seconds_bucket{service="payments"}[5m]))'
        description: "P99 latency"
    logLabels:
      app: payments-api
    # gitlabProject: "team/payments-api"                        # For the `changes` provider role
    # corootAppId: "default:Deployment:payments-api"            # Usually set by discovery

  - name: checkout-service
    metrics:
      - query: 'rate(http_requests_total{service="checkout"}[5m])'
        description: "Request rate"
    logLabels:
      app: checkout-service

# Alternate names per service — lets chat/intent match "payments" → "payments-api"
# serviceAliases:
#   payments-api: [payments, pay]
#   checkout-service: [checkout]

discovery:
  autoRefresh: false          # Set to true to re-discover on server start
  maxIterations: 40           # Max agent iterations during discovery
  # Discovery skills are controlled by Settings > Skills: scope includes
  # discovery, and the skill is enabled for the current stack.
  # Cap each MCP tool result before it enters the discover agent's message
  # history. Bounds prompt growth across iterations so accumulated context
  # plus the reserved completion budget stays under the model's context
  # window. Without this cap a single unfiltered k8s_pods_list (~83k chars)
  # plus 30 more tool calls overflows even a 128k-token window. Set 0 to
  # disable.
  maxToolResultChars: 30000
  # Max completion tokens reserved for the discover agent's response. Some
  # OpenAI-compatible gateways reject requests with "max_tokens must be at
  # least 1, got -N" when prompt_tokens plus this value exceed the model's
  # context window. Lower for stacks with smaller context (e.g. 4096 on a
  # 16k-token model); raise for very large environments where the JSON
  # output truncates. Range: 256–65536.
  maxOutputTokens: 8192
  excludeServices:            # Services to exclude from auto-discovery
    - consul
    - prometheus
    - grafana
    - node-exporter
    - alertmanager
  # Per-provider hints for the discovery agent
  # discoveryRecipes:
  #   - providerType: prometheus-k8s
  #     serviceQueries:
  #       - 'group by (app) (up)'
  #     labelKeys: [app, service, job]
  #   - providerType: coroot
  #     serviceQueries: []
  #     labelKeys: [app]

agent:
  maxIterations: 20
  # Phrases that flip chat → investigation. Omit to use defaults.
  # investigationTriggerPhrases:
  #   - investigate
  #   - why is
  #   - what's wrong
  #   - is down
  #   - is slow
  #   - root cause

# Chat memory — in-process by default; libsql persists across restarts
memory:
  storage: memory             # memory | libsql
  # dbPath: .dops/memory.db   # Only used when storage: libsql

# Skills loader — scans a directory for markdown skills the agent can call
skills:
  dir: ./skills
  maxPerQuery: 3
  maxCharsPerSkill: 2000

timeouts:
  mcpConnectMs: 30000
  llmCallMs: 120000
  toolExecutionMs: 60000
  agentIterationMs: 180000

retry:
  maxAttempts: 3
  baseDelayMs: 500

# UI branding — shown in the web header
branding:
  title: dops
  subtitle: assistant

# Alert webhook — receives Alertmanager payloads to trigger auto-investigations
webhook:
  # Bearer tokens are generated in Settings -> Alert Webhooks and scoped to
  # the active stack. Use the URL shown there; non-default stacks post to
  # /api/webhook/alert/<stack-slug>.
  # Deprecated yaml-managed webhook.secret / webhook.tokens entries are imported
  # into the DB at startup for migration; remove them after alert senders use
  # DB-backed tokens.
  dedupWindowSeconds: 300                # Skip repeat alerts for same service within this window
  maxConcurrent: 3                       # Max simultaneous webhook-triggered investigations
  defaultTemplate: standard              # quick | standard | full
  severityTemplateMap:                   # Map alert severity to investigation template
    critical: full
    warning: standard
    info: quick
  # slackWebhookUrl: "${SLACK_WEBHOOK_URL}"  # Legacy fallback — prefer Settings → Notifications in the UI

# Proactive system scans — disabled by default.
# When enabled, a cron-scheduled probe walks every registered service and evaluates
# probe rules (written by `npm run discover` or declared under services/probe below).
# Rules that trip for `consecutiveTicks` ticks in a row spawn a headless investigation.
# Every tick creates a durable ScanRun visible on the Operations Desk.
scan:
  enabled: false
  cron: "0 */4 * * *"                    # every 4 hours — standard cron syntax
  timezone: "UTC"                        # IANA zone, e.g. "America/Los_Angeles"
  maxInvestigationsPerTick: 5            # cap on child investigations per tick
  investigationTemplate: standard        # quick | standard | full
  runOnEnable: true                      # kick off an immediate scan the first time this block enables
  dedupWindowMinutes: 30                 # skip firing on a rule that tripped recently

  # Probe engine tuning. Most operators leave these at defaults.
  probe:
    concurrency: 8                       # parallel service evaluations
    queryTimeoutMs: 3000                 # per-PromQL-query timeout
    logsQueryTimeoutMs: 10000            # per-LogQL-query timeout (Loki 15m windows are slow)
    # metrics: []                        # Custom stack-wide rules. Discovery writes these into
                                         # services.yaml:globalProbeRules — override here only if
                                         # you know what you're doing.

# Email notifications — deliver completed RCA reports to any inbox.
# Slack webhook + scan-run notifications are configured at Settings → Notifications in the UI
# (recipients, severity thresholds, and source allowlists are runtime settings, not config).
# notifications:
#   email:
#     enabled: true
#     from: "dops@example.com"
#     appBaseUrl: "https://dops.example.com"  # used to build deep links in the email body
#     smtp:
#       host: smtp.example.com
#       port: 587
#       secure: false                    # true for implicit TLS on port 465
#       user: "${SMTP_USER}"
#       pass: "${SMTP_PASS}"
#     retry:
#       attempts: 4
#       backoffMs: [1000, 5000, 30000]   # length must equal attempts - 1
